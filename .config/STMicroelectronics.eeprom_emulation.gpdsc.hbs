  *
 ****************************************************************************** -->
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55"
  xsi:noNamespaceSchemaLocation="PACK.xsd" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0"
  xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13"
  Dname="STM32*">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="2.0.0" date="2026-03-16">
      - First GPDSC template Model Release
    </release>
  </releases>
  <conditions>
    {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="EEPROM_Emulation Config")}}
    {{{@root.conditions}}}
    {{!-- Excluded conditions by Id above could optionally be handled dynamically in this section--}}
    {{!-- #Start Dynamic condition handling section# --}}
    <condition id="EEPROM_Emulation Config">
      <description>Selection of the EEPROM Emulation dependencies based on the selected flash type and resource allocation</description>
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="core" />
{{#if (eq @root.eeprom_emulation_cxt.basic.flash_type "NVM")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="algo" Cvariant="NVM" />
{{else}}
  {{#if (eq @root.eeprom_emulation_cxt.basic.flash_type "FLITF")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="algo" Cvariant="FLITF" />
  {{/if}}
{{/if}}
{{#if (eq @root.eeprom_emulation_cxt.resourcesAllocation.flash.interface "NVM_EDATA")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_flash" Cvariant="NVM_EDATA" />
{{else}}
  {{#if (eq @root.eeprom_emulation_cxt.resourcesAllocation.flash.interface "FLITF_EDATA")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_flash" Cvariant="FLITF_EDATA" />
  {{else}}
    {{#if (eq @root.eeprom_emulation_cxt.resourcesAllocation.flash.interface "CUSTOM")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_flash" Cvariant="FLASH template" />
    {{/if}}
  {{/if}}
{{/if}}
{{#if (eq @root.eeprom_emulation_cxt.resourcesAllocation.crc.interface "CUSTOM")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_crc" Cvariant="CRC template" />
{{else}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_crc" Cvariant="CRC" />
{{/if}}
{{#if (eq @root.eeprom_emulation_cxt.basic.flash_type "NVM")}}
  {{#if (eq @root.eeprom_emulation_cxt.resourcesAllocation.ecc.interface "CUSTOM")}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_ecc" Cvariant="ECC template" />
  {{else}}
      <require Cclass="Utility" Cgroup="eeprom emulation" Csub="itf_ecc" Cvariant="ECC" />
  {{/if}}
{{/if}}
    </condition>
    {{!-- This is an optional section, if you do not want to handle conditions dynamically, you can bypass this --}}
    {{!-- #End Dynamic condition handling section# --}}
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>